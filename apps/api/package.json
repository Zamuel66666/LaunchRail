{
  "name": "@launchrail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@launchrail/application": "workspace:*",
    "@launchrail/config": "workspace:*",
    "@launchrail/contracts": "workspace:*",
    "@launchrail/database": "workspace:*",
    "@launchrail/domain": "workspace:*",
    "@launchrail/observability": "workspace:*",
    "fastify": "5.11.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-orm": "0.45.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
