# LaunchRail local development configuration
NODE_ENV=development
LOG_LEVEL=info

# Application health endpoints
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4001
WORKER_MODE=run
WORKER_QUEUE_NAME=launchrail-deployments
WORKER_QUEUE_PREFIX=launchrail
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=5
WORKER_JOB_TIMEOUT_MS=300000
WORKER_BACKOFF_BASE_MS=1000
WORKER_BACKOFF_CAP_MS=60000
WORKER_LEASE_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_RECONCILIATION_INTERVAL_MS=15000
WORKER_RECONCILIATION_BATCH_SIZE=100
WORKER_SHUTDOWN_GRACE_MS=30000
WORKER_BUILD_ROOT=/tmp/launchrail-builds
WORKER_BUILD_TIMEOUT_MS=240000
WORKER_BUILD_PLATFORM=linux/amd64
WORKER_BUILD_MEMORY_MEGABYTES=1024
WORKER_BUILD_CPU_MILLICORES=1000
WORKER_BUILD_PROCESS_LIMIT=256
WORKER_BUILD_SHARED_MEMORY_MEGABYTES=64
WORKER_BUILD_PROGRESS_BYTES=8388608
WORKER_BUILD_PROGRESS_LINE_BYTES=65536
WORKER_BUILD_LOG_CHUNK_BYTES=16384
WORKER_BUILD_LOG_MAX_BYTES=1048576
WORKER_BUILD_IMAGE_MAX_BYTES=1073741824
WORKER_BUILD_METADATA_BYTES=65536
WORKER_BUILD_INSPECT_BYTES=262144
WORKER_RUNTIME_TIMEOUT_MS=5000
WORKER_SOURCE_ROOT=/tmp/launchrail-sources
WORKER_SOURCE_RESOLVE_TIMEOUT_MS=10000
WORKER_SOURCE_RESOLVE_RESPONSE_BYTES=4194304
WORKER_SOURCE_CLONE_TIMEOUT_MS=120000
WORKER_SOURCE_GIT_DIRECTORY_BYTES=402653184
WORKER_SOURCE_GIT_OUTPUT_BYTES=65536
WORKER_SOURCE_MAX_FILES=20000
WORKER_SOURCE_MAX_BYTES=268435456
WORKER_SOURCE_MAX_FILE_BYTES=16777216
WORKER_SOURCE_MAX_PATH_BYTES=1024
WORKER_SOURCE_MAX_DEPTH=64
WEB_HOST=127.0.0.1
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=launchrail_session
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_HOURS=24
SIGN_IN_RATE_LIMIT_MAX=5

# Project-secret encryption has no committed key. Generate a 32-byte base64url key and set both
# values in the untracked .env file. Preserve old versions during rotation until data is re-encrypted.
# LAUNCHRAIL_SECRET_KEYRING=1:<base64url-encoded-32-byte-key>
# LAUNCHRAIL_ACTIVE_SECRET_KEY_VERSION=1

# First-owner bootstrap values have no defaults. Set them only in the untracked .env file.
# LAUNCHRAIL_BOOTSTRAP_EMAIL=
# LAUNCHRAIL_BOOTSTRAP_DISPLAY_NAME=
# LAUNCHRAIL_BOOTSTRAP_ORGANIZATION_NAME=
# LAUNCHRAIL_BOOTSTRAP_ORGANIZATION_SLUG=
# LAUNCHRAIL_BOOTSTRAP_PASSWORD=

# PostgreSQL development service
POSTGRES_DB=launchrail
POSTGRES_USER=launchrail
POSTGRES_PASSWORD=launchrail_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://launchrail:launchrail_dev_only@127.0.0.1:5432/launchrail

# Redis development service
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Traefik local preview routing
TRAEFIK_PORT=8080
TRAEFIK_DYNAMIC_CONFIG_DIR=./.launchrail/traefik
