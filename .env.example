# LaunchRail local development configuration
NODE_ENV=development
LOG_LEVEL=info

# Application health endpoints
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4001
WEB_HOST=127.0.0.1
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# PostgreSQL development service
POSTGRES_DB=launchrail
POSTGRES_USER=launchrail
POSTGRES_PASSWORD=launchrail_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://launchrail:launchrail_dev_only@127.0.0.1:5432/launchrail

# Redis development service
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
