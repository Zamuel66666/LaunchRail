{
  "name": "@launchrail/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "auth:bootstrap": "tsx --env-file-if-exists=../../.env src/bootstrap.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@launchrail/application": "workspace:*",
    "@launchrail/contracts": "workspace:*",
    "@launchrail/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
