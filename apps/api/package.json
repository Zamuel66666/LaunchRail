{
  "name": "@launchrail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@launchrail/config": "workspace:*",
    "@launchrail/contracts": "workspace:*",
    "@launchrail/observability": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
